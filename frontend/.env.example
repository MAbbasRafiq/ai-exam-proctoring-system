# On LAN quiz day, set this to your laptop's IP, e.g.:
# VITE_API_URL=http://192.168.1.10:8000
VITE_API_URL=http://127.0.0.1:8000

# Real AI (YOLO) frame analysis. false = no analyze calls; code stays in repo.
# Set true + restart npm for small demos. Keep false for ~100-student class.
VITE_AI_MONITORING_ENABLED=false

# Webcam preview. false = no camera at all. true = live preview (deterrence).
VITE_WEBCAM_ENABLED=true

# true = teacher can add short-answer questions (must match backend flag)
VITE_SHORT_QUESTIONS_ENABLED=false

