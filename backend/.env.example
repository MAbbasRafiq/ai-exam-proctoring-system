# Copy to .env and adjust for your machine
DATABASE_URL=postgresql://postgres:yourpassword@localhost/exam_system

# Use a long random string for class day (not the default)
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated origins, or * for LAN demo (allows any browser origin)
CORS_ORIGINS=*

# false = public register is students only (recommended for class)
# true = temporarily allow creating teacher via /auth/register
ALLOW_TEACHER_REGISTER=false

# true = teachers can add short-answer questions (manual grading)
SHORT_QUESTIONS_ENABLED=false

# Optional: bind hint for docs only — start uvicorn with --host 0.0.0.0
HOST=0.0.0.0
PORT=8000
